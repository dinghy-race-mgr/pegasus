							<m_strCustomExpr>// decodes winner string

$winarr = array("1"=&gt;"1st - ", "2"=&gt;"2nd - ","3"=&gt;"3rd - ");
$txt = "";

foreach($winarr as $k=&gt;$win)
{
	if ($k != "1") { $txt.= "&lt;br&gt; "; }
	if (!empty($data["winner_$k"])) 
	{ 
		$txt.= "$win"; 
	  $txtarr = explode("|", $data["winner_$k"]);
	  foreach ($txtarr as $element){ $txt.= $element." &amp;nbsp;"; }
	}
}

$value = $txt;

</m_strCustomExpr>
