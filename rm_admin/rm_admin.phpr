					<m_strEventCode>

$srchObj = SearchClause::getSearchObject("t_tide"); 

$value1 = $srchObj-&gt;getFieldValue("hw1_time");
$value2 = $srchObj-&gt;getSecondFieldValue("hw1_time");

if( $value1 != null ) {

$srchObj-&gt;setSearchSQL("hw1_time", "(hw1_time &gt;= '$value1' and hw1_time &lt;= '$value2') OR (hw2_time &gt;= '$value1' and hw2_time &lt;= '$value2')");

}



