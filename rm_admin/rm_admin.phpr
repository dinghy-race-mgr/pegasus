					<m_strName>EVENT_PROCESSVALUES_ADD</m_strName>
					<m_strEventCode>global $conn;

// set target events ditrectory for documents
unset($_SESSION['event_uploads_dir']);

$rs = DB::Query("select * from e_event where id = {$values['eid']}");
while( $row = $rs-&gt;fetchAssoc() )
{
	$_SESSION['event_uploads_dir'] = $row['nickname'];
}

//echo "&lt;pre&gt;".print_r($values,true)."&lt;/pre&gt;";
//echo "&lt;pre&gt;{$_SESSION['event_uploads_dir']}&lt;/pre&gt;";
</m_strEventCode>
