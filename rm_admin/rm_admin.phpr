			<m_strSQL>SELECT
id,
firstname,
familyname AS surname,
concat(firstname, ' ', familyname) AS fullname,
rota,
phone,
email,
note,
updby,
upddate,
partner,
active,
memberid,
dtm_login,
createdate
FROM t_rotamember
ORDER BY surname
</m_strSQL>
