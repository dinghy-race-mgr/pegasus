					<m_strEventCode>// mark data direcory as deleted

$year = date("Y",strtotime($deleted_values['date-start']));
$dir = "../../data/events/$year/{$deleted_values['nickname']}";
$upd = rename($dir,$dir."_DELETED");

if ($upd) 
{
	$message = "event data directory marked as deleted";
}
else
{
	$message = "FAILED to set event data directory as deleted - please do it manually";
}

// Place event code here.
// Use "Add Action" button to add code snippets.</m_strEventCode>
