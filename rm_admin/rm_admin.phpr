					<m_strEventCode>
// set fields for later use
$_SESSION['copy']['eventid']   = $values['eventid'];
$_SESSION['copy']['fleet']     = $values['fleet'];
$_SESSION['copy']['race_type'] = $values['race_type'];

// unset fields that need to be changed
if ($values['race_type'] == "pursuit")
{
		unset($values['competitorid']);  // competitor
		unset($values['points']);        // points
		unset($values['lap']);           // laps
		unset($values['code']);          // code
		unset($values['penalty']);       // penalty
}
else
{
		unset($values['competitorid']);  // competitor
		unset($values['etval']);         // elapsed time
		unset($values['lap']);           // laps
		unset($values['code']);          // code
		unset($values['penalty']);       // penalty
}</m_strEventCode>
