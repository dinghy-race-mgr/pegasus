					</v>
					<v>
						<m_isRunTime>0</m_isRunTime>
						<m_strPage>List page</m_strPage>
						<m_strName>EVENT_BEFOREDELETE</m_strName>
						<m_strEventCode>global $conn;

// don't allow deletion if competitors still reference this class
$strSQLExists = "SELECT * from t_competitor WHERE classid='{$deleted_values['id']}'";
$rsExists = db_query($strSQLExists,$conn);
$data=db_fetch_array($rsExists);
if ($data)
{
	$message = "the {$deleted_values['classname']} class has registered competitors sailing this boat - please remove them if you want to delete this class";
	return false;
}

return true;</m_strEventCode>
						<m_strEventID>EVENT_BEFOREDELETE</m_strEventID>
