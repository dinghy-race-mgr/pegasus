			<query>
				<m_sql>SELECT
id,
eventid,
fleet,
race_type,
competitorid,
`class`,
sailnum,
pn,
apn,
helm,
crew,
club,
lap,
etime,
sec_to_time(etime) AS etval,
ctime,
atime,
code,
penalty,
points,
declaration,
note,
'' as warning,
upddate,
updby,
createdate
FROM t_result
ORDER BY fleet, points
</m_sql>
				<m_parsed>1</m_parsed>
				<type>SQL::Query</type>
				<m_strHead>SELECT</m_strHead>
				<m_strFieldList>id,
eventid,
fleet,
race_type,
competitorid,
`class`,
sailnum,
pn,
apn,
helm,
crew,
club,
lap,
etime,
sec_to_time(etime) AS etval,
ctime,
atime,
code,
penalty,
points,
declaration,
note,
'' as warning,
upddate,
updby,
createdate</m_strFieldList>
				<m_strFrom>FROM t_result</m_strFrom>
				<m_strWhere />
				<m_strOrderBy>ORDER BY fleet, points</m_strOrderBy>
				<m_strTail />
				<m_where>
					<m_sql />
