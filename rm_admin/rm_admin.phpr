				<m_strSQL>SELECT
id,
acronym,
classname,
info,
popular,
nat_py,
local_py,
rya_id,
category,
numcrew,
rig,
spin,
engine,
keel,
updby,
upddate
FROM t_class
ORDER BY popular DESC, classname
</m_strSQL>
