					<m_strEventCode>global $conn;
require_once ("./include/rma_common_event.php");
require_once ("../../common/lib/fieldchk_lib.php");

$commit = true;
$mode = "add";

// handle tidal data according to mode
if ($_SESSION['tidal_mode'] == "none")
{
	$values['tide_time'] = "";
	$values['tide_height'] = "";
}

// set start time to hh:mm
if (!empty($values['event_start']))
{
	$values['event_start'] = date("H:i", strtotime($values['event_start']));
}

require_once ("./include/t_event_addeditbefore.php");

if (!$commit)
{
	return false;
}
return true;



</m_strEventCode>
