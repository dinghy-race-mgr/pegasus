					<m_strPage>Add page</m_strPage>
					<m_strName>EVENT_BEFOREADD</m_strName>
					<m_strEventCode>global $conn;

unset($_SESSION['event_uploads_dir']);

// get event information
$rs = db_query("SELECT * FROM e_event WHERE id = '{$values['eid']}'", $conn);
$event = db_fetch_array($rs);

// set event year
$eventyear = date("Y", strtotime($event['date-start']));

// set relative target directory within  racemanager data directory
$_SESSION['event_uploads_dir'] = "../../data/events/$eventyear/{$event['nickname']}";

// set audit fields
$values['updby']   = $_SESSION['UserID'];
$values['upddate'] = NOW();

require_once ("./include/e_document_addeditbefore.php");

if (!$commit)
{
	return false;
}
return true;</m_strEventCode>
					<m_strEventID>EVENT_BEFOREADD</m_strEventID>
					<m_strWidgetID />
					<sub />
					<m_caption>
						<text />
						<nameType>Text</nameType>
					</m_caption>
					<m_strDotNetLanguage>cs</m_strDotNetLanguage>
				</v>
				<v>
					<m_isRunTime>0</m_isRunTime>
					<m_strPage>Edit page</m_strPage>
					<m_strName>EVENT_BEFOREEDIT</m_strName>
					<m_strEventCode>$values['updby'] = $_SESSION['UserID'];
$values['upddate'] = NOW();

require_once ("./include/e_document_addeditbefore.php");

if (!$commit)
{
	return false;
}
return true;
</m_strEventCode>
					<m_strEventID>EVENT_BEFOREEDIT</m_strEventID>
					<m_strWidgetID />
					<sub />
					<m_caption>
						<text />
						<nameType>Text</nameType>
					</m_caption>
					<m_strDotNetLanguage>cs</m_strDotNetLanguage>
				</v>
				<v>
