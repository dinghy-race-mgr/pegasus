					<m_strEventCode>global $conn;

// do not delete the series configuration just mark it as not active
$updby = $_SESSION['UserID'];
$upddate = NOW();

$sql = "UPDATE t_series SET active = 0, upddate = '$upddate', updby = '$updby' WHERE $where ";
$rs = db_query($sql, $conn);

$message = "Series {$deleted_values['seriesname']} marked as not current";

return false;</m_strEventCode>
