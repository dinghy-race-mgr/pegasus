			<m_strSQL>SELECT
id,
eventid,
fleet,
race_type,
competitorid,
`class`,
sailnum,
pn,
apn,
helm,
crew,
club,
lap,
etime,
sec_to_time(etime) AS etval,
ctime,
atime,
code,
penalty,
points,
declaration,
note,
'' as warning,
upddate,
updby,
createdate
FROM t_result
ORDER BY fleet, points
</m_strSQL>
