			<query>
				<m_sql>SELECT
id,
category,
question,
answer,
notes,
author,
pursuit,
eventname,
format,
startdate,
enddate,
multirace,
listorder,
active,
upddate,
updby,
createdate
FROM t_help
ORDER BY category, listorder
