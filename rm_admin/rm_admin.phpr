					<m_strEventCode>// Moves uploaded file to correct place on server
//error_log("upload string: ".print_r($values['upload'],true)."\n", 3, $_SESSION['dbg_file']);
//error_reporting(E_ERROR | E_WARNING | E_PARSE | E_NOTICE);
if (!empty($values['upload']))
{
	$filespec = json_decode(trim($values['upload'],"[]"),true);
  //error_log("FILESPEC: ".print_r($filespec,true)."\n", 3, $_SESSION['dbg_file']);
  
  $oldpath = $filespec['name'];
	//error_log("new_path: $oldpath\n", 3, $_SESSION['dbg_file']);
  
  $newpath = $_SESSION['result_path']."\\{$values['folder']}\\{$values['filename']}";
  //error_log("new_path: $newpath\n", 3, $_SESSION['dbg_file']);
  
  //$chk1 = file_exists($oldpath);
  //$chk2 = file_exists($newpath);
  //$chk3 = is_writable($newpath);
	//error_log("checks: |$chk1|$chk2|$chk3|\n", 3, $_SESSION['dbg_file']);

	rename ($oldpath, $newpath);
}</m_strEventCode>
