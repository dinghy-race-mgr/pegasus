			<query>
				<m_sql>SELECT
	t_competitor.id,
	classid,
	boatnum,
	sailnum,
	boatname,
	hullcolour,
	helm,
	helm_dob,
	helm_email,
	telephone,
	t_competitor.crew,
	crew_dob,
	crew_email,
	club,
	personal_py,
	skill_level,
	flight,
	regular,
	last_entry,
	last_event,
	t_competitor.active,
	prizelist,
	grouplist,
	memberid,
	trackerid,
	t_competitor.upddate,
	t_competitor.updby,
	t_competitor.createdate,
  classname
FROM t_competitor
INNER JOIN t_class ON t_competitor.classid = t_class.id
ORDER BY classname ASC, cast(sailnum as signed) ASC</m_sql>
				<m_parsed>1</m_parsed>
