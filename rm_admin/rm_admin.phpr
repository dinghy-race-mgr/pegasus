			<query>
				<m_sql>SELECT
id,
firstname,
familyname AS surname,
concat(firstname, ' ', familyname) AS fullname,
rota,
phone,
email,
note,
updby,
upddate,
partner,
active,
memberid,
dtm_login,
createdate
FROM t_rotamember
ORDER BY surname
</m_sql>
				<m_parsed>1</m_parsed>
				<type>SQL::Query</type>
				<m_strHead>SELECT</m_strHead>
				<m_strFieldList>id,
