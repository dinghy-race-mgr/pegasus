							<v>
								<m_strField>title</m_strField>
								<m_strLabel>Event: </m_strLabel>
								<m_strTooltip></m_strTooltip>
								<m_strPlaceholder>the name of the event (e.g. Merlin Rocket Open Meeting)</m_strPlaceholder>
							</v>
							<v>
								<m_strField>nickname</m_strField>
								<m_strLabel>Internal Name</m_strLabel>
								<m_strTooltip>use lower case class names separated with a dash e.g. merlin, ilca-solo-phantom  (n.b use merlin-2 if second  event in one year)</m_strTooltip>
								<m_strPlaceholder>short internal name ( e.g. solo-ilca-phantom )</m_strPlaceholder>
							</v>
							<v>
								<m_strField>sub-title</m_strField>
								<m_strLabel>Sub-title</m_strLabel>
								<m_strTooltip></m_strTooltip>
								<m_strPlaceholder>additional info (e.g. Silver Tiller and SW Series Event)</m_strPlaceholder>
							</v>
							<v>
								<m_strField>list-status-txt</m_strField>
								<m_strLabel>Status Message</m_strLabel>
								<m_strTooltip>appears as a status message on opening event list page</m_strTooltip>
								<m_strPlaceholder>e.g. Entries open on 12 June</m_strPlaceholder>
							</v>
							<v>
								<m_strField>date-start</m_strField>
								<m_strLabel>Start Date</m_strLabel>
								<m_strTooltip></m_strTooltip>
								<m_strPlaceholder>start date (dd/mm/yyyy)</m_strPlaceholder>
							</v>
							<v>
								<m_strField>date-end</m_strField>
								<m_strLabel>End Date</m_strLabel>
								<m_strTooltip></m_strTooltip>
								<m_strPlaceholder>end date (dd/mm/yyyy)</m_strPlaceholder>
							</v>
							<v>
								<m_strField>topics</m_strField>
								<m_strLabel>Standard Topics</m_strLabel>
								<m_strTooltip>pick common  topics to be included on  details page (e.g. camping)</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>publish-status</m_strField>
								<m_strLabel>Status</m_strLabel>
								<m_strTooltip>"list" to only include in events list, "detail" to also show details pages</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
