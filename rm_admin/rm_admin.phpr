					<m_strEventCode>global $conn;

$rsExists = db_query("select max(start_num) as maxstart, max(fleet_num) as maxfleet from t_cfgfleet where `eventcfgid` = {$_SESSION['t_cfgfleet_masterkey1']}", $conn);
$data = db_fetch_array($rsExists);

$values['fleet_num'] = $data['maxfleet'] + 1;
$values['start_num'] = $data['maxstart'] + 1;
</m_strEventCode>
