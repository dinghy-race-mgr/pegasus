					<m_strEventCode>// if pursuit set start interval to 0
if ($values['pursuit']==1)
{
	$values['start_interval'] = 0;
}
else  // chek if start interval is set 
{
		if ( $values['numstarts'] &gt; 1 and $values['start_interval'] == 0 )
		{
			$message = "there are {$values['numstarts']} starts - the interval between starts cannot be 0 minutes";
			return false;
		}
}

$values['updby']   = $_SESSION['UserID'];
$values['upddate'] = NOW();
return true;

</m_strEventCode>
