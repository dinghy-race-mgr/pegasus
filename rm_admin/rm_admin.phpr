$str= "&lt;select style='width: 150px; display: inline-block;' class='form-control' onchange=\"window.location.href=this.options[this.".
"selectedIndex].value;\"&gt;&lt;option value=\"\"&gt;Pick page ...&lt;/option&gt;";

$strSQL = "select `code`, `label` from t_code_system where groupname='system_pages' order by `listorder`";
$rs = db_query($strSQL);
