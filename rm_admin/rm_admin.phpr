			<m_strSQL>SELECT
id,
event_date,
event_start,
event_order,
event_name,
series_code,
series_code_extra,
event_type,
event_format,
event_entry,
event_status,
event_open,
event_ood,
tide_time,
tide_height,
start_scheme,
start_interval,
ws_start,
wd_start,
ws_end,
wd_end,
event_notes,
result_notes,
display_code,
upddate,
updby,
REPLACE(series_code, CONCAT("-", RIGHT(YEAR(event_date),2)), "") AS series_root,
REPLACE(series_code_extra, CONCAT("-", RIGHT(YEAR(event_date),2)), "") AS series_root_extra,
id as id1,
id as idlog,
event_date as datelog
FROM t_event
WHERE (event_name NOT LIKE '%DEMO%') AND (event_type = 'racing') AND (event_status NOT IN ('scheduled', 'selected', 'running'))
ORDER BY event_date DESC, event_start, event_order
</m_strSQL>
			<m_sqlHead>SELECT id,
