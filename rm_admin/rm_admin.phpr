					<m_strPage>Add page</m_strPage>
					<m_strName>EVENT_BEFOREADD</m_strName>
					<m_strEventCode>// copy  fields from t_trophy
if (!empty($values['trophyid']))
{
   $rs = DB::Query("select * from t_trophy where id = '{$values['trophyid']}' LIMIT 1 ");
   if ($rs)
   {
       $trophy = $rs-&gt;fetchAssoc();
       $values['award_category'] = $trophy['current_allocation'];
       $values['award_division'] = $trophy['current_division'];  
   }
   else
   {
      return false; // can't find data to create record
   }
}
else
{
   return false;   // failed to create  record
}

// set audit fields
$values['updby']   = $_SESSION['UserID'];

// remove spaces in period field
$values['period'] = str_replace(" ","",$values['period']);

// remove space in winner_X fields
for ($i = 1; $i &lt;= 3; $i++)
{
   $arr = explode("|",$values["winner_".$i]);
   foreach ($arr as $k=&gt;$r)
   {
        $arr[$k] = trim($r);
   }
   $values["winner_".$i] = implode("|",$arr);
}

return true;</m_strEventCode>
					<m_strEventID>EVENT_BEFOREADD</m_strEventID>
					<m_strWidgetID />
					<sub />
					<m_caption>
						<text />
						<nameType>Text</nameType>
					</m_caption>
					<m_strDotNetLanguage>cs</m_strDotNetLanguage>
				</v>
				<v>
					<m_isRunTime>0</m_isRunTime>
					<m_strPage>Edit page</m_strPage>
					<m_strName>EVENT_BEFOREEDIT</m_strName>
					<m_strEventCode>
// set audit fields
$values['updby']   = $_SESSION['UserID'];

// remove spaces in period field
$values['period'] = str_replace(" ","",$values['period']);

