$commit = true;
$mode = "edit";

// handle tidal data accoring to mode
if ($_SESSION['tidal_mode'] == "none")
{
	$values['tide_time'] = "";
	$values['tide_height'] = "";
}

// reformat start time to hh:mm
if (!empty($values['event_start']))
{
	$values['event_start'] = date("H:i", strtotime($values['event_start']));
}

if (!$inline) { require_once ("./include/t_event_addeditbefore.php"); } 


if (!$commit)
{
	return false;
}
return true;</m_strEventCode>
