							<m_strCustomExpr>
if (intval($data['b-personalpn']) &gt; 0 )
{
	$color = "green";
  $val = $data['b-personalpn'];
}
elseif ($data['b-pn'] == "0")
{
	$color = "orangered";
  $val = "?";
}
else
{
	$val = $data['b-pn'];
  $color = "steelblue";
}
$value="&lt;span style='color: $color;font-weight: 600'&gt;$val&lt;/span&gt;";


