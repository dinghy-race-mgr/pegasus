					<v>
						<m_strTableName>t_cfgfleet</m_strTableName>
						<m_strTableLabel>Fleets</m_strTableLabel>
						<m_arrFieldLabels>
							<v>
								<m_strField>id</m_strField>
								<m_strLabel>id</m_strLabel>
								<m_strTooltip></m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>py_type</m_strField>
								<m_strLabel>Handicap Type</m_strLabel>
								<m_strTooltip>PY numbers to be used for this race.  REQUIRED for pursuit race.</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>upddate</m_strField>
								<m_strLabel>Update</m_strLabel>
								<m_strTooltip></m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>updby</m_strField>
								<m_strLabel>By</m_strLabel>
								<m_strTooltip></m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>eventcfgid</m_strField>
								<m_strLabel>Race Format</m_strLabel>
								<m_strTooltip></m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>start_num</m_strField>
								<m_strLabel>Start No.</m_strLabel>
								<m_strTooltip>start number for this fleet(e.g. use 1 for first start) - there can be multiple fleets in each start</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>defaultlaps</m_strField>
								<m_strLabel>Default Laps</m_strLabel>
								<m_strTooltip>default laps to be set for this fleet - 0 if it must be set by OOD</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>defaultfleet</m_strField>
								<m_strLabel>Default Fleet</m_strLabel>
								<m_strTooltip>tick if this is the "catch all" fleet for classes not eligible for any other fleets - can only be one fleet</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>classinc</m_strField>
								<m_strLabel>Include classes ...</m_strLabel>
								<m_strTooltip>select the specific classes that MUST be allocated to this fleet  </m_strTooltip>
								<m_strPlaceholder>add classes to specifically include</m_strPlaceholder>
							</v>
							<v>
								<m_strField>onlyinc</m_strField>
								<m_strLabel>Only these?</m_strLabel>
								<m_strTooltip>tick if ONLY these classes are allowed in this fleet</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>classexc</m_strField>
								<m_strLabel>Exclude classes ...</m_strLabel>
								<m_strTooltip>select classes to be excluded if they would otherwise be included by the other constraints </m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>min_py</m_strField>
								<m_strLabel>Fastest PN (lowest)</m_strLabel>
								<m_strTooltip>fastest PY eligible for this fleet (leave blank if PY not a constraint).  REQUIRED for pursuit race.</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>max_py</m_strField>
								<m_strLabel>Slowest PN (highest)</m_strLabel>
								<m_strTooltip>slowest PY eligible for this fleet (leave blank if PY not a constraint). REQUIRED for pursuit race.</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>crew</m_strField>
								<m_strLabel>Crew Type</m_strLabel>
								<m_strTooltip>number of crew constraint for this fleet - leave blank if any is eligible</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>spintype</m_strField>
								<m_strLabel>Spinnaker Type</m_strLabel>
								<m_strTooltip>spinnaker constraint for this fleet  - leave blank if any is eligible</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>hulltype</m_strField>
								<m_strLabel>Hull Type</m_strLabel>
								<m_strTooltip>hull type constraint for this fleet - leave blank if any is eligible</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>min_helmage</m_strField>
								<m_strLabel>Lowest Age (youngest)</m_strLabel>
								<m_strTooltip>minimum age for this race - leave blank if no lower age limit</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>max_helmage</m_strField>
								<m_strLabel>Highest Age (oldest)</m_strLabel>
								<m_strTooltip>maximum age for this race - leave blank if no upper age limit</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>min_skill</m_strField>
								<m_strLabel>Highest Skill Level</m_strLabel>
								<m_strTooltip>highest skill level eligible for this race -  leave blank if no skill level limit</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>max_skill</m_strField>
								<m_strLabel>Lowest Skill Level</m_strLabel>
								<m_strTooltip>lowest skill level eligible for this race -  leave blank if no skill level limit</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>groupinc</m_strField>
								<m_strLabel>Eligible Groups</m_strLabel>
								<m_strTooltip>pick any competitor groups that a competitor must be a member of to be eligible for this race (e.g. beginner) - if open to all leave blank.</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>warn_signal</m_strField>
								<m_strLabel>Warning Signal</m_strLabel>
								<m_strTooltip>warning flag/signal to be used for this fleet - must be the same for all fleets using this start</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>prep_signal</m_strField>
								<m_strLabel>Preparatory Signal</m_strLabel>
								<m_strTooltip>preparatory flag/signal to be used for this fleet - must be the same for all fleets using this start</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>timelimit_abs</m_strField>
								<m_strLabel>Absolute Time Limit</m_strLabel>
								<m_strTooltip>absolute time limit in minutes (i.e. first boat needs to finish within N mins).  REQUIRED for a pursuit race</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>timelimit_rel</m_strField>
								<m_strLabel>Relative Time Limit</m_strLabel>
								<m_strTooltip>relative time limit in minutes (e.g limit for finishers after leading boat finishes).  0 if no relative time limit</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>fleet_num</m_strField>
								<m_strLabel>Fleet No.</m_strLabel>
								<m_strTooltip>fleet number - number from 1... n</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>fleet_code</m_strField>
								<m_strLabel>Fleet Code</m_strLabel>
								<m_strTooltip>short code for this fleet (max 10 chars)</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>fleet_name</m_strField>
								<m_strLabel>Fleet Name</m_strLabel>
								<m_strTooltip>full name for this fleet</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>fleet_desc</m_strField>
								<m_strLabel>Description</m_strLabel>
								<m_strTooltip>short description of the fleet to provide information to the OOD</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>scoring</m_strField>
								<m_strLabel>Scoring</m_strLabel>
								<m_strTooltip>scoring scheme used for this fleet</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
						</m_arrFieldLabels>
						<m_arrPageTitleLabels>
							<v>
								<m_strPage>add</m_strPage>
								<m_strTitle>Add New Fleet Configuration</m_strTitle>
							</v>
							<v>
								<m_strPage>edit</m_strPage>
								<m_strTitle>Edit Fleet Configuration - {%fleet_code}</m_strTitle>
							</v>
							<v>
								<m_strPage>list</m_strPage>
								<m_strTitle>Fleet Configuration</m_strTitle>
							</v>
							<v>
								<m_strPage>view</m_strPage>
								<m_strTitle>View Fleet Configuration - {%fleet_code}</m_strTitle>
							</v>
						</m_arrPageTitleLabels>
					</v>
					<v>
						<m_strTableName>t_event</m_strTableName>
						<m_strTableLabel>Events</m_strTableLabel>
						<m_arrFieldLabels>
							<v>
								<m_strField>id</m_strField>
								<m_strLabel>id</m_strLabel>
								<m_strTooltip></m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>event_date</m_strField>
								<m_strLabel>Date</m_strLabel>
								<m_strTooltip></m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>event_start</m_strField>
								<m_strLabel>Time</m_strLabel>
								<m_strTooltip>event start time (e.g 15:30) </m_strTooltip>
								<m_strPlaceholder>hh:mm</m_strPlaceholder>
							</v>
							<v>
								<m_strField>event_name</m_strField>
								<m_strLabel>Name</m_strLabel>
								<m_strTooltip>do not include race no. in event name</m_strTooltip>
								<m_strPlaceholder>name of event (e.g Spring Series)</m_strPlaceholder>
							</v>
							<v>
								<m_strField>event_format</m_strField>
								<m_strLabel>Format</m_strLabel>
								<m_strTooltip>pick race format to be used for this event - leave blank if not a racing event</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>event_entry</m_strField>
								<m_strLabel>Entry</m_strLabel>
								<m_strTooltip>pick method for collecting entries for the race (normally the same for all races) - leave blank if not a racing event</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>event_status</m_strField>
								<m_strLabel>Status</m_strLabel>
								<m_strTooltip>sets race status MUST be 'scheduled' for new events - don't change this value unless you are sure you know what you are doing.</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>tide_time</m_strField>
								<m_strLabel>Tide Time</m_strLabel>
								<m_strTooltip></m_strTooltip>
								<m_strPlaceholder>local time for high water (hh:mm)</m_strPlaceholder>
							</v>
							<v>
								<m_strField>tide_height</m_strField>
								<m_strLabel>Tide Height</m_strLabel>
								<m_strTooltip></m_strTooltip>
								<m_strPlaceholder>high water height (m)  e.g. 3.7</m_strPlaceholder>
							</v>
							<v>
								<m_strField>ws_start</m_strField>
								<m_strLabel>Wind Speed - Start</m_strLabel>
								<m_strTooltip>set wind speed at start of race</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>wd_start</m_strField>
								<m_strLabel>Wind - Start</m_strLabel>
								<m_strTooltip></m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>ws_end</m_strField>
								<m_strLabel>Wind Speed - End</m_strLabel>
								<m_strTooltip>set wind speed at end of race</m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
								<m_strField>wd_end</m_strField>
								<m_strLabel>Wind - End</m_strLabel>
								<m_strTooltip></m_strTooltip>
								<m_strPlaceholder></m_strPlaceholder>
							</v>
							<v>
