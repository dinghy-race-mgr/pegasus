					<m_strEventCode>
global $conn;
require_once ("./include/rma_common_event.php");

$_SESSION['rm_event_copy'] = $values['orig_id'];    // need to get copied event id from a duplicate of the field (see sql)

// clear dates, races
$values['date-start'] = "";
$values['date-end']   = "";
$values['entry-start'] = "";
$values['entry-end']   = "";
$values['races']       = "";
$values['createdate']  = "";

// clear list_status_text
$values['list-status-txt'] = ""; 

// set publish status
$values['publish-status'] = "list";</m_strEventCode>
					<m_strEventID>EVENT_COPY_ONLOAD</m_strEventID>
					<m_strWidgetID />
					<sub />
