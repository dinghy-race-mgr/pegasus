					<m_strEventCode>//check for posible issues
$data['warning'] = "";
if ($data['code'] == "DPI" and $data['penalty'] == "0.0")
 {
	  $data['warning'].= " WARNING: DPI code but no penalty set)";
 }

if (($data['code'] == "ZFP" or $data['code'] == "SCP") and $data['penalty'] == "0.0")
{
  $data['warning'].= " WARNING: {$data['code']} penalty code but no penalty set)";
}


return true;</m_strEventCode>
