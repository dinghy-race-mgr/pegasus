			<m_strSQL>SELECT
id,
event_date,
event_start,
event_order,
event_name,
series_code,
series_code_extra,
event_type,
event_format,
event_entry,
event_status,
event_open,
tide_time,
tide_height,
start_scheme,
start_interval,
ws_start,
wd_start,
ws_end,
wd_end,
event_notes,
result_notes,
display_code,
upddate,
updby,
weblink,
webname,
active,
REPLACE(series_code, CONCAT("-", RIGHT(YEAR(event_date),2)), "") AS series_root,
REPLACE(series_code_extra, CONCAT("-", RIGHT(YEAR(event_date),2)), "") AS series_root_extra,
event_ood
FROM t_event
WHERE (event_name NOT LIKE '%DEMO%')
ORDER BY event_date, event_order, event_start
</m_strSQL>
