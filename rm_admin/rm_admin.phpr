					<m_strEventCode>global $conn;
require_once ("./include/rma_common_event.php");
require_once ("../../common/lib/fieldchk_lib.php");

$commit = true;
$mode = "add";

require_once ("./include/e_event_addeditbefore.php");

if (!$commit)
{
	return false;
}
return true;</m_strEventCode>
